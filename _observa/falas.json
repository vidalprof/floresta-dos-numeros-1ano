 {
  "id": "ob_10hpdj2",
  "texto": "Olhe a legenda: procure o numero deste balao e veja a cor do lado.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1qnyqik",
  "texto": "Toque nas figuras e depois em Terminei.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1ec2ze4",
  "texto": "Olhe o desenho com calma e procure ele do outro lado.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1o016in",
  "texto": "Va uma de cada vez. Qual delas ainda nao tem par?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_gm9bw0",
  "texto": "A sombra tem o mesmo formato, so que toda escura.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1qini2e",
  "texto": "Olhe o contorno: onde ele e redondo e onde ele e comprido?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_4v8gov",
  "texto": "Tres deles sao o mesmo desenho. Ache o que nao e.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1n74nje",
  "texto": "Pense no que eles sao: o que se come e o que anda na rua.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_ul16lk",
  "texto": "Diga a fila em voz alta, do comeco. O que vem sempre depois?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1w77xs4",
  "texto": "Conte de tres em tres: um, dois, tres, e comeca de novo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_s69mtb",
  "texto": "Escreva a palavra usando o teclado.",
  "voz": "pt-BR-AntonioNeural"
 },
