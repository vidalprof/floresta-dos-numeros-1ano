 },
 {
  "id": "ob_b5uusb",
  "texto": "Você chegou ao fim! Agora olhe em volta da sala: dá para achar duas coisas iguais? E alguma coisa que não é da família das outras?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1d9s73k",
  "texto": "Folha pronta! Muito bem.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1cuiocy",
  "texto": "Amarelo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_2tjxvt",
  "texto": "Azul.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_37uetd",
  "texto": "Roxo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_wor0rv",
  "texto": "Verde.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1lnxl49",
  "texto": "Vermelho.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_dudk3k",
  "texto": "Toque numa figura do lado esquerdo e depois na do lado direito.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_158guex",
  "texto": "Nao era o par. Guarde onde estavam e tente outra vez.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1h1u2kd",
  "texto": "Voce achou os quatro pares! Que memoria boa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_1gbhjfq",
  "texto": "Achou o par! Amora.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ob_ohvksi",
