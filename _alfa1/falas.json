 {
  "id": "al_q9aj2x",
  "texto": "Toque primeiro na figura e depois na sílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_hutccf",
  "texto": "Caderno novo, com palavras novas. Vamos de novo!",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_1e0jp4o",
  "texto": "Folha dez: recorte e cole. Puxe cada sílaba para debaixo da figura certa, ou toque na sílaba e depois na figura.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_17tnxur",
  "texto": "Folha um: a letra escondida. Uma letra fugiu da palavra. Olhe a figura, ouça a palavra e toque na letra certa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_1c1ve42",
  "texto": "Folha dois: quantas sílabas. Fale a palavra batendo uma palma em cada pedaço. Depois toque em Pronto.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_txls1w",
  "texto": "Folha três: o que vem depois. Olhe a fila de figuras, descubra a ordem que se repete e escolha a que vem depois.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_l41oe5",
  "texto": "Folha quatro: circule quem começa igual. Toque em todos os desenhos que começam com a sílaba mostrada. Depois toque em Conferir.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_he3chm",
  "texto": "Folha cinco: pinte a sílaba inicial. Toque na sílaba com que a palavra começa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_1ayqes4",
  "texto": "Folha seis: ligue à sílaba final. Toque na figura e depois na sílaba com que ela termina.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_qwu83p",
  "texto": "Folha sete: marque a sílaba do meio. Toque na sílaba que fica no meio da palavra.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_1mzkcuq",
  "texto": "Folha oito: escreva a sílaba que falta. Toque no quadradinho e escreva a sílaba, no teclado da tela ou no teclado de verdade.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "al_1g61ro",
  "texto": "Folha nove: ordene e forme a palavra. As sílabas embaralharam. Toque nelas na ordem certa.",
  "voz": "pt-BR-AntonioNeural"
 },
