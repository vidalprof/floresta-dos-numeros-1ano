 },
 {
  "id": "op_anwcp7",
  "texto": "Já achou 5 de 7! Faltam as outras."
 },
 {
  "id": "op_1mewojw",
  "texto": "Já achou 6 de 7! Faltam as outras."
 },
 {
  "id": "op_1s4dw2w",
  "texto": "Ouça: casinha. Ache o desenho que combina."
 },
 {
  "id": "op_16zs4d7",
  "texto": "Ouça: gatinho. Ache o desenho que combina."
 },
 {
  "id": "op_15w9ucp",
  "texto": "Primeiro toque na ficha lá de cima. Depois toque na gaveta."
 },
 {
  "id": "op_1tb3eb9",
  "texto": "Quem vai jogar hoje?"
 },
 {
  "id": "op_3giti8",
  "texto": "Vou abrir este par: gatinho — o gato pequeno."
 },
 {
  "id": "op_f774h3",
  "texto": "já aconteceu, é passado"
 },
 {
  "id": "op_mqeyz7",
  "texto": "vai acontecer, é futuro"
 },
 {
  "id": "op_1yn5a8u",
  "texto": "Vou abrir este par: casinha — a casa pequena."
 },
 {
  "id": "op_1g3u3lh",
  "texto": "Abri uma para você: gatinho. Ache o par dela."
 },
 {
