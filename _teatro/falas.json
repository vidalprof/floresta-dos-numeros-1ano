[
 {
  "id": "tp_abertura",
  "texto": "O Teatro das Palavras vai estrear, mas o roteiro se embaralhou: faltam as ordens das cenas, os nomes certos e as palavras que descrevem os personagens. Só quem entende a história e as palavras salva o espetáculo. Vem?"
 },
 {
  "id": "tp_f01_intro",
  "texto": "Leia o trecho e escolha a resposta certa."
 },
 {
  "id": "tp_f01_dica",
  "texto": "Releia devagar; a resposta está no texto."
 },
 {
  "id": "op_8k9kw4",
  "texto": "Leia: «Tico subiu ao palco. A plateia fez silêncio. Seu coração batia forte, mas ele respirou fundo e começou a contar a história.» Como o Tico se sentiu?"
 },
 {
  "id": "op_9c12yk",
  "texto": "Nervoso, mas foi corajoso"
 },
 {
  "id": "op_wbhahz",
  "texto": "Estava com sono"
 },
 {
  "id": "op_wb79zj",
  "texto": "Estava com fome"
 },
 {
  "id": "op_1t7stsd",
  "texto": "Ficou com raiva"
 },
 {
  "id": "op_57kqe3",
  "texto": "Procure a parte do coração dele."
 },
 {
  "id": "op_1864m1y",
  "texto": "«Coração batia forte» = nervoso; «respirou fundo e começou» = coragem."
 },
 {
  "id": "op_1e9ieah",
  "texto": "É «Nervoso, mas foi corajoso»."
 },
 {
  "id": "op_buoijn",
  "texto": "Quem subiu ao palco?"
 },
 {
  "id": "op_3oz8n7",
  "texto": "O Tico"
 },
 {
  "id": "op_ln7kyu",
  "texto": "A plateia"
 },
 {
  "id": "op_uds3sm",
  "texto": "A cortina"
 },
 {
  "id": "op_lxw67s",
  "texto": "O roteiro"
 },
 {
  "id": "op_1kossr3",
  "texto": "Quem age na cena?"
 },
 {
  "id": "op_1m7fmtr",
  "texto": "Foi o Tico."
 },
 {
  "id": "op_1i6opk0",
  "texto": "É «O Tico»."
 },
 {
  "id": "tp_f02_intro",
  "texto": "Separe: é pronome pessoal ou não é?"
 },
 {
  "id": "tp_f02_dica",
  "texto": "Pessoal nomeia quem: eu, tu, ele, nós."
 },
 {
  "id": "op_2jmpbw",
  "texto": "PRONOMEPESSOAL"
 },
 {
  "id": "op_1flgxny",
  "texto": "NÃO ÉPRONOME"
 },
 {
  "id": "op_3ho73",
  "texto": "eu"
 },
 {
  "id": "op_3776c7",
  "texto": "ela"
 },
 {
  "id": "op_377hcp",
  "texto": "nós"
 },
 {
  "id": "op_ykmror",
  "texto": "mesa"
 },
 {
  "id": "op_1wi8byq",
  "texto": "correr"
 },
 {
  "id": "op_ykgre6",
  "texto": "eles"
 },
 {
  "id": "op_gc5z48",
  "texto": "Pessoal: eu, tu, ele, ela, nós, eles."
 },
 {
  "id": "op_15aqpag",
  "texto": "«Mesa» é coisa; «correr» é ação."
 },
 {
  "id": "op_4cpnog",
  "texto": "Nomeia alguém ou não?"
 },
 {
  "id": "tp_f03_intro",
  "texto": "Preencha a frase com o pronome certo."
 },
 {
  "id": "tp_f03_dica",
  "texto": "Qual palavrinha substitui o nome?"
 },
 {
  "id": "op_oyqzg7",
  "texto": "Maria chegou ao teatro."
 },
 {
  "id": "op_70klv0",
  "texto": ", feliz, subiu ao palco."
 },
 {
  "id": "op_ykk0kk",
  "texto": "Isto"
 },
 {
  "id": "op_1v93kea",
  "texto": "Aquele"
 },
 {
  "id": "op_1euy627",
  "texto": "Substitui «Maria»."
 },
 {
  "id": "op_1k2cfrf",
  "texto": "João e eu ensaiamos muito."
 },
 {
  "id": "op_d71v3k",
  "texto": "vamos brilhar!"
 },
 {
  "id": "op_3776cb",
  "texto": "Ele"
 },
 {
  "id": "op_1v93nrk",
  "texto": "Aquilo"
 },
 {
  "id": "op_10roccb",
  "texto": "Você + o João = nós."
 },
 {
  "id": "op_1u1yh4r",
  "texto": "Os atores chegaram."
 },
 {
  "id": "op_10ewdfq",
  "texto": "estão prontos."
 },
 {
  "id": "op_ykgxm9",
  "texto": "Essa"
 },
 {
  "id": "op_huexk",
  "texto": "Substitui «os atores»: eles."
 },
 {
  "id": "tp_f04_intro",
  "texto": "Ligue cada personagem ao adjetivo que o descreve."
 },
 {
  "id": "tp_f04_dica",
  "texto": "Adjetivo diz COMO a coisa é."
 },
 {
  "id": "op_3ot2pj",
  "texto": "O leão"
 },
 {
  "id": "op_kpw2cl",
  "texto": "corajoso"
 },
 {
  "id": "op_187fn3l",
  "texto": "A tartaruga"
 },
 {
  "id": "op_4eczdl",
  "texto": "lenta"
 },
 {
  "id": "op_151ei4w",
  "texto": "O palhaço"
 },
 {
  "id": "op_wl8hnx",
  "texto": "engraçado"
 },
 {
  "id": "op_zuudk5",
  "texto": "A noite"
 },
 {
  "id": "op_1xvc58o",
  "texto": "escura"
 },
 {
  "id": "op_15lqtjv",
  "texto": "Pense: como é cada um?"
 },
 {
  "id": "op_ffl4gc",
  "texto": "Leão corajoso; tartaruga lenta; palhaço engraçado; noite escura."
 },
 {
  "id": "op_dwszhe",
  "texto": "Ligue à qualidade certa."
 },
 {
  "id": "tp_f05_intro",
  "texto": "Leia e descubra o que se entende."
 },
 {
  "id": "tp_f05_dica",
  "texto": "A resposta não está escrita — dá para descobrir."
 },
 {
  "id": "op_5gkqft",
  "texto": "Leia: «Lia olhou o céu escuro, pegou o guarda-chuva e correu para a escola.» Como devia estar o tempo?"
 },
 {
  "id": "op_1kkr0ye",
  "texto": "Ia chover"
 },
 {
  "id": "op_qr6hrh",
  "texto": "Ensolarado"
 },
 {
  "id": "op_364swg",
  "texto": "Nevando"
 },
 {
  "id": "op_5j89es",
  "texto": "Muito calor"
 },
 {
  "id": "op_1joa2av",
  "texto": "Por que o guarda-chuva?"
 },
 {
  "id": "op_1gym7iu",
  "texto": "Céu escuro + guarda-chuva = ia chover."
 },
 {
  "id": "op_4umwmr",
  "texto": "É «Ia chover»."
 },
 {
  "id": "tp_f06_intro",
  "texto": "Separe: pessoal ou demonstrativo?"
 },
 {
  "id": "tp_f06_dica",
  "texto": "Pessoal = QUEM; demonstrativo = APONTA."
 },
 {
  "id": "op_g23vbo",
  "texto": "PRONOMEDEMONSTRATIVO"
 },
 {
  "id": "op_ykgxna",
  "texto": "este"
 },
 {
  "id": "op_1v93ke6",
  "texto": "aquela"
 },
 {
  "id": "op_ykk0jn",
  "texto": "isso"
 },
 {
  "id": "op_ixtuvp",
  "texto": "Pessoal: eu, tu, ele, nós."
 },
 {
  "id": "op_ianukn",
  "texto": "Demonstrativo: este, esse, aquele, isto, isso."
 },
 {
  "id": "op_1wm3jng",
  "texto": "Nomeia QUEM ou APONTA?"
 },
 {
  "id": "tp_f07_intro",
  "texto": "Preencha com o demonstrativo certo."
 },
 {
  "id": "tp_f07_dica",
  "texto": "Perto de você, do outro ou longe?"
 },
 {
  "id": "op_4h6hrv",
  "texto": "Pegue"
 },
 {
  "id": "op_1ysbzsk",
  "texto": "roteiro que está perto de você."
 },
 {
  "id": "op_ykgxmd",
  "texto": "esse"
 },
 {
  "id": "op_y7kmnb",
  "texto": "Perto de quem ouve: esse."
 },
 {
  "id": "op_4i86r5",
  "texto": "Quero"
 },
 {
  "id": "op_1n6w7ze",
  "texto": "livro aqui na minha mão."
 },
 {
  "id": "op_1fhtl69",
  "texto": "Bem perto de quem fala: este."
 },
 {
  "id": "op_yktp0r",
  "texto": "Veja"
 },
 {
  "id": "op_178pnz3",
  "texto": "estrela lá no alto do palco."
 },
 {
  "id": "op_dansz4",
  "texto": "Longe dos dois: aquela."
 },
 {
  "id": "tp_f08_intro",
  "texto": "Ligue cada coisa ao adjetivo da história."
 },
 {
  "id": "tp_f08_dica",
  "texto": "Leia a qualidade e ache o que combina."
 },
 {
  "id": "op_1vjl21k",
  "texto": "A estrela do palco"
 },
 {
  "id": "op_nmza9q",
  "texto": "brilhante"
 },
 {
  "id": "op_173qw1b",
  "texto": "O velho baú"
 },
 {
  "id": "op_6hspre",
  "texto": "empoeirado"
 },
 {
  "id": "op_bqs86u",
  "texto": "O riso da plateia"
 },
 {
  "id": "op_1v58791",
  "texto": "alegre"
 },
 {
  "id": "op_18bzz0k",
  "texto": "O vento da noite"
 },
 {
  "id": "op_1yw8cwh",
  "texto": "gelado"
 },
 {
  "id": "op_1cyskwc",
  "texto": "Como é cada um na cena?"
 },
 {
  "id": "op_sgrlg4",
  "texto": "Estrela brilhante; baú empoeirado; riso alegre; vento gelado."
 },
 {
  "id": "op_n1djba",
  "texto": "Ligue certo."
 },
 {
  "id": "tp_f09_intro",
  "texto": "Passe o marca-texto nos adjetivos."
 },
 {
  "id": "tp_f09_dica",
  "texto": "Adjetivo diz COMO a coisa é."
 },
 {
  "id": "op_3t3o",
  "texto": "O"
 },
 {
  "id": "op_4h3ilw",
  "texto": "PALCO"
 },
 {
  "id": "op_3776hp",
  "texto": "era"
 },
 {
  "id": "op_42kmu",
  "texto": "GRANDE"
 },
 {
  "id": "op_1mr6wdx",
  "texto": "CORTINA"
 },
 {
  "id": "op_1mfu9rt",
  "texto": "VERMELHA"
 },
 {
  "id": "op_5oyykz",
  "texto": "PESADA"
 },
 {
  "id": "op_gto58w",
  "texto": "os ADJETIVOS"
 },
 {
  "id": "tp_f10_intro",
  "texto": "Leia e responda sobre o personagem."
 },
 {
  "id": "tp_f10_dica",
  "texto": "Pense no que ele fez e por quê."
 },
 {
  "id": "op_1aey1ns",
  "texto": "Leia: «O gato fugiu quando o cachorro latiu bem alto.» Por que o gato fugiu?"
 },
 {
  "id": "op_1qoeg7k",
  "texto": "Porque o cachorro latiu alto"
 },
 {
  "id": "op_1fvf24r",
  "texto": "Porque estava com fome"
 },
 {
  "id": "op_1c0vwnk",
  "texto": "Porque era de dia"
 },
 {
  "id": "op_11ysutl",
  "texto": "Porque queria brincar"
 },
 {
  "id": "op_1otwrl8",
  "texto": "O que aconteceu ANTES de ele fugir?"
 },
 {
  "id": "op_1wpsxw0",
  "texto": "O latido alto assustou o gato."
 },
 {
  "id": "op_1ww0mnh",
  "texto": "É «Porque o cachorro latiu alto»."
 },
 {
  "id": "tp_f11_intro",
  "texto": "Coloque as cenas na ordem em que aconteceram."
 },
 {
  "id": "tp_f11_dica",
  "texto": "Qual foi a PRIMEIRA coisa?"
 },
 {
  "id": "op_achqas",
  "texto": "Tico recebeu o convite."
 },
 {
  "id": "op_rl3z3w",
  "texto": "Ensaiou a fala."
 },
 {
  "id": "op_djh3tm",
  "texto": "Subiu ao palco."
 },
 {
  "id": "op_1x83sll",
  "texto": "A ORDEM DA HISTÓRIA"
 },
 {
  "id": "op_w1fbri",
  "texto": "Coloque as cenas na ordem em que aconteceram."
 },
 {
  "id": "op_k62kdd",
  "texto": "Toque na cena que vem primeiro."
 },
 {
  "id": "op_1v8d5hx",
  "texto": "Qual aconteceu PRIMEIRO?"
 },
 {
  "id": "op_vsxm4e",
  "texto": "A primeira que falta está piscando."
 },
 {
  "id": "op_fa3mo2",
  "texto": "Era esta! Eu coloco e você segue."
 },
 {
  "id": "op_1w66bky",
  "texto": "História na ordem certa!"
 },
 {
  "id": "tp_f12_intro",
  "texto": "De novo: pessoal ou demonstrativo?"
 },
 {
  "id": "tp_f12_dica",
  "texto": "Lembre: quem × aponta."
 },
 {
  "id": "op_3hoku",
  "texto": "tu"
 },
 {
  "id": "op_377o2p",
  "texto": "vós"
 },
 {
  "id": "op_1tk37iq",
  "texto": "Pessoal: eu, tu, ele, nós, vós, eles."
 },
 {
  "id": "op_ezj9u2",
  "texto": "Demonstrativo: este/esse/aquele, isto/isso/aquilo."
 },
 {
  "id": "op_mmv2df",
  "texto": "QUEM ou APONTA?"
 },
 {
  "id": "tp_f13_intro",
  "texto": "Preencha com o pronome certo."
 },
 {
  "id": "tp_f13_dica",
  "texto": "Pessoal substitui; demonstrativo aponta."
 },
 {
  "id": "op_12h2ytu",
  "texto": "A atriz esqueceu a fala, mas"
 },
 {
  "id": "op_1ykor0y",
  "texto": "se lembrou logo."
 },
 {
  "id": "op_ktevao",
  "texto": "Substitui «a atriz»."
 },
 {
  "id": "op_kxvy8k",
  "texto": "Não quero este chapéu, quero"
 },
 {
  "id": "op_1xrikrl",
  "texto": "que está ali."
 },
 {
  "id": "op_wm1sj6",
  "texto": "Aponta o que está longe."
 },
 {
  "id": "op_1rbv27h",
  "texto": "Você e eu vamos juntos."
 },
 {
  "id": "op_18um44j",
  "texto": ", combinamos tudo."
 },
 {
  "id": "op_1j3a8e3",
  "texto": "Você + eu = nós."
 },
 {
  "id": "tp_f14_intro",
  "texto": "Ligue cada coisa ao seu adjetivo."
 },
 {
  "id": "tp_f14_dica",
  "texto": "Como é cada uma?"
 },
 {
  "id": "op_4f07c2",
  "texto": "O sol"
 },
 {
  "id": "op_6n9zrr",
  "texto": "quente"
 },
 {
  "id": "op_3op517",
  "texto": "O gelo"
 },
 {
  "id": "op_ykho9h",
  "texto": "frio"
 },
 {
  "id": "op_1tnstqi",
  "texto": "A pena"
 },
 {
  "id": "op_ykm01d",
  "texto": "leve"
 },
 {
  "id": "op_zw1e4y",
  "texto": "A pedra"
 },
 {
  "id": "op_16cu1ff",
  "texto": "Pense na qualidade de cada um."
 },
 {
  "id": "op_1tczirp",
  "texto": "Sol quente; gelo frio; pena leve; pedra pesada."
 },
 {
  "id": "tp_f15_intro",
  "texto": "Marque os adjetivos desta descrição."
 },
 {
  "id": "tp_f15_dica",
  "texto": "São as palavras que dizem COMO cada coisa é."
 },
 {
  "id": "op_173tuo1",
  "texto": "PALHAÇO"
 },
 {
  "id": "op_11kp89p",
  "texto": "tinha nariz"
 },
 {
  "id": "op_1mfu9s7",
  "texto": "VERMELHO"
 },
 {
  "id": "op_1ymixho",
  "texto": ", sapatos"
 },
 {
  "id": "op_tqflz2",
  "texto": "ENORMES"
 },
 {
  "id": "op_1u0lbbx",
  "texto": "e um sorriso"
 },
 {
  "id": "op_4e9zi2",
  "texto": "LARGO"
 },
 {
  "id": "op_h4538y",
  "texto": "COLORIDA"
 },
 {
  "id": "tp_f16_intro",
  "texto": "Ache os adjetivos escondidos (todas as direções)."
 },
 {
  "id": "tp_f16_dica",
  "texto": "Adjetivo diz como algo é."
 },
 {
  "id": "op_t6zhw4",
  "texto": "VALENTE"
 },
 {
  "id": "op_1vuu8sw",
  "texto": "BONITO"
 },
 {
  "id": "op_6wos04",
  "texto": "RAPIDO"
 },
 {
  "id": "op_f437a4",
  "texto": "CACE OS ADJETIVOS"
 },
 {
  "id": "op_377i1a",
  "texto": "sim"
 },
 {
  "id": "tp_f17_intro",
  "texto": "Leia a descrição e responda."
 },
 {
  "id": "tp_f17_dica",
  "texto": "A resposta está nos detalhes."
 },
 {
  "id": "op_u5viro",
  "texto": "Leia: «A sala era pequena e escura. Havia teias nos cantos e cheiro de mofo.» Como era a sala?"
 },
 {
  "id": "op_12zsqb7",
  "texto": "Velha e abandonada"
 },
 {
  "id": "op_uhowep",
  "texto": "Nova e limpa"
 },
 {
  "id": "op_1nu8ue6",
  "texto": "Grande e clara"
 },
 {
  "id": "op_kji93v",
  "texto": "Cheia de gente"
 },
 {
  "id": "op_183d6vp",
  "texto": "Junte: escura, teias, mofo."
 },
 {
  "id": "op_1mxmpge",
  "texto": "Escura + teias + mofo = velha e abandonada."
 },
 {
  "id": "op_5h8ids",
  "texto": "É «Velha e abandonada»."
 },
 {
  "id": "tp_f18_intro",
  "texto": "Coloque a história toda em ordem."
 },
 {
  "id": "tp_f18_dica",
  "texto": "Comece pelo que aconteceu primeiro."
 },
 {
  "id": "op_13kltm0",
  "texto": "Tico acordou animado."
 },
 {
  "id": "op_11lcvck",
  "texto": "Vestiu a roupa de estrela."
 },
 {
  "id": "op_18rtsqk",
  "texto": "Todos aplaudiram."
 },
 {
  "id": "op_ujq5uv",
  "texto": "Coloque as 5 cenas em ordem."
 },
 {
  "id": "op_zszozz",
  "texto": "Qual foi a PRIMEIRA?"
 },
 {
  "id": "op_ce0mc0",
  "texto": "Espetáculo na ordem certa!"
 },
 {
  "id": "tp_f19_aquec_intro",
  "texto": "Revisão rápida! Escolha a resposta certa."
 },
 {
  "id": "tp_f19_aquec_dica",
  "texto": "Você já viu isso nas fases anteriores."
 },
 {
  "id": "op_h4f1c4",
  "texto": "Na frase «Ela é corajosa», qual é o adjetivo?"
 },
 {
  "id": "op_kpw2c7",
  "texto": "corajosa"
 },
 {
  "id": "op_4felwz",
  "texto": "muito"
 },
 {
  "id": "op_19ngdza",
  "texto": "Adjetivo diz como alguém é."
 },
 {
  "id": "op_1vn2r0l",
  "texto": "«Corajosa» descreve como ela é."
 },
 {
  "id": "op_m0qe2c",
  "texto": "É «corajosa»."
 },
 {
  "id": "op_11xpnnv",
  "texto": "Na frase «Aquele palco é enorme», qual é o pronome demonstrativo?"
 },
 {
  "id": "op_1xs2817",
  "texto": "enorme"
 },
 {
  "id": "op_pgbhhd",
  "texto": "Qual palavra APONTA?"
 },
 {
  "id": "op_1lwffxo",
  "texto": "«Aquele» aponta o palco longe."
 },
 {
  "id": "op_eoqpwf",
  "texto": "É «Aquele»."
 },
 {
  "id": "op_1mjfjdh",
  "texto": "Na frase «Nós vamos ensaiar», qual é o pronome pessoal?"
 },
 {
  "id": "op_4lc24r",
  "texto": "vamos"
 },
 {
  "id": "op_tsw3d4",
  "texto": "ensaiar"
 },
 {
  "id": "op_15aeb6w",
  "texto": "Qual nomeia QUEM?"
 },
 {
  "id": "op_1t6lkzl",
  "texto": "«Nós» = você e os colegas."
 },
 {
  "id": "op_1fmqrg6",
  "texto": "É «Nós»."
 },
 {
  "id": "tp_f20_intro",
  "texto": "Separe os demonstrativos: perto ou longe?"
 },
 {
  "id": "tp_f20_dica",
  "texto": "Este/esse = perto; aquele = longe."
 },
 {
  "id": "op_8zmab1",
  "texto": "PERTO(este, esse)"
 },
 {
  "id": "op_bx6d7s",
  "texto": "LONGE(aquele)"
 },
 {
  "id": "op_b2rakl",
  "texto": "Este/esse ficam perto de quem fala ou ouve."
 },
 {
  "id": "op_vrmdoc",
  "texto": "Aquele/aquela/aquilo ficam longe dos dois."
 },
 {
  "id": "op_rir61z",
  "texto": "Perto ou longe?"
 },
 {
  "id": "tp_f21_intro",
  "texto": "Preencha com o pronome pessoal certo."
 },
 {
  "id": "tp_f21_dica",
  "texto": "Quem faz a ação?"
 },
 {
  "id": "op_irtfwf",
  "texto": "O palhaço caiu, mas"
 },
 {
  "id": "op_leu4n1",
  "texto": "levantou rindo."
 },
 {
  "id": "op_1t5r8uo",
  "texto": "Substitui «o palhaço»."
 },
 {
  "id": "op_si4lyw",
  "texto": "As bailarinas dançaram."
 },
 {
  "id": "op_4dxyrm",
  "texto": "giraram no palco."
 },
 {
  "id": "op_ykgrai",
  "texto": "Elas"
 },
 {
  "id": "op_hvkwen",
  "texto": "Substitui «as bailarinas»."
 },
 {
  "id": "op_1nzc3sv",
  "texto": "Eu e a Lia cantamos."
 },
 {
  "id": "op_1yukn5v",
  "texto": "ensaiamos junto."
 },
 {
  "id": "op_1bu4wio",
  "texto": "Eu + a Lia = nós."
 },
 {
  "id": "tp_f22_intro",
  "texto": "Ligue cada adjetivo ao seu contrário."
 },
 {
  "id": "tp_f22_dica",
  "texto": "Um é o oposto do outro."
 },
 {
  "id": "op_ykdout",
  "texto": "alto"
 },
 {
  "id": "op_477lqw",
  "texto": "baixo"
 },
 {
  "id": "op_9f2c04",
  "texto": "rápido"
 },
 {
  "id": "op_4eczdz",
  "texto": "lento"
 },
 {
  "id": "op_485aye",
  "texto": "claro"
 },
 {
  "id": "op_1xvc592",
  "texto": "escuro"
 },
 {
  "id": "op_19su6zm",
  "texto": "pequeno"
 },
 {
  "id": "op_3mgwko",
  "texto": "Pense no oposto de cada palavra."
 },
 {
  "id": "op_eu9qs4",
  "texto": "Alto×baixo; rápido×lento; claro×escuro; grande×pequeno."
 },
 {
  "id": "op_1e3jhhr",
  "texto": "Ligue os contrários."
 },
 {
  "id": "tp_f23_intro",
  "texto": "Marque os adjetivos da personagem."
 },
 {
  "id": "tp_f23_dica",
  "texto": "Diga COMO ela é."
 },
 {
  "id": "op_3t3a",
  "texto": "A"
 },
 {
  "id": "op_19ls7mw",
  "texto": "BAILARINA"
 },
 {
  "id": "op_1fx2p3i",
  "texto": "GRACIOSA"
 },
 {
  "id": "op_yke0n5",
  "texto": "AZUL"
 },
 {
  "id": "op_j0csl4",
  "texto": "brilhava na luz"
 },
 {
  "id": "op_4ac9np",
  "texto": "FORTE"
 },
 {
  "id": "tp_f24_intro",
  "texto": "Ache os adjetivos (todas as direções)."
 },
 {
  "id": "tp_f24_dica",
  "texto": "Palavras que descrevem: como é."
 },
 {
  "id": "op_4ez20e",
  "texto": "MACIO"
 },
 {
  "id": "tp_f25_intro",
  "texto": "Leia e escolha o final certo."
 },
 {
  "id": "tp_f25_dica",
  "texto": "Pense no que combina com a história."
 },
 {
  "id": "op_9avfhx",
  "texto": "Leia: «Depois de ensaiar muito, chegou o grande dia. Tico não errou nenhuma fala.» O que se espera no fim?"
 },
 {
  "id": "op_1ranhff",
  "texto": "A plateia aplaudiu"
 },
 {
  "id": "op_wvceop",
  "texto": "Todos foram embora"
 },
 {
  "id": "op_25lmwr",
  "texto": "Choveu no palco"
 },
 {
  "id": "op_nrpaot",
  "texto": "O teatro fechou"
 },
 {
  "id": "op_1u2uq7g",
  "texto": "Se ele foi bem, o que a plateia faz?"
 },
 {
  "id": "op_5woy4y",
  "texto": "Ele acertou tudo → aplausos."
 },
 {
  "id": "op_1abmeag",
  "texto": "É «A plateia aplaudiu»."
 },
 {
  "id": "tp_f26_intro",
  "texto": "Ponha o dia da Lia em ordem."
 },
 {
  "id": "tp_f26_dica",
  "texto": "Do começo ao fim do dia."
 },
 {
  "id": "op_8jqn92",
  "texto": "Lia acordou."
 },
 {
  "id": "op_19fpqd6",
  "texto": "Tomou café."
 },
 {
  "id": "op_r7fuug",
  "texto": "Foi à escola."
 },
 {
  "id": "op_gulut4",
  "texto": "Voltou para casa."
 },
 {
  "id": "op_i1vun9",
  "texto": "MONTE O DIA"
 },
 {
  "id": "op_1izn53j",
  "texto": "Ponha o dia em ordem."
 },
 {
  "id": "op_1nqp3yw",
  "texto": "Toque no que vem primeiro."
 },
 {
  "id": "op_1jsv2by",
  "texto": "O que se faz primeiro de manhã?"
 },
 {
  "id": "op_3sfupc",
  "texto": "A primeira que falta pisca."
 },
 {
  "id": "op_16k1qtn",
  "texto": "Era esta!"
 },
 {
  "id": "op_1u8ly4p",
  "texto": "Dia na ordem certa!"
 },
 {
  "id": "tp_f27_intro",
  "texto": "Mais uma: separe certo."
 },
 {
  "id": "tp_f27_dica",
  "texto": "Quem × aponta, você já sabe."
 },
 {
  "id": "op_5pkvdt",
  "texto": "Pessoal nomeia pessoas."
 },
 {
  "id": "op_m9l57r",
  "texto": "Demonstrativo aponta coisas."
 },
 {
  "id": "tp_f28_intro",
  "texto": "Preencha com o adjetivo que combina."
 },
 {
  "id": "tp_f28_dica",
  "texto": "Como está a coisa na frase?"
 },
 {
  "id": "op_kv3e5g",
  "texto": "Depois de correr, o menino ficou muito"
 },
 {
  "id": "op_1dm4yke",
  "texto": "cansado"
 },
 {
  "id": "op_1des6su",
  "texto": "cadeira"
 },
 {
  "id": "op_4hix55",
  "texto": "pular"
 },
 {
  "id": "op_1coim5x",
  "texto": "Como ele fica depois de correr?"
 },
 {
  "id": "op_bxkjv8",
  "texto": "O sorvete estava bem"
 },
 {
  "id": "op_c3icm3",
  "texto": "Como é um sorvete? Frio, gelado."
 },
 {
  "id": "op_1b7gnxd",
  "texto": "A estrela do teatro é"
 },
 {
  "id": "op_1q8ovk",
  "texto": "janela"
 },
 {
  "id": "op_4le3th",
  "texto": "Como é uma estrela? Brilhante."
 },
 {
  "id": "tp_f29_intro",
  "texto": "Ligue a personagem ao jeito dela."
 },
 {
  "id": "tp_f29_dica",
  "texto": "Como cada uma é na história?"
 },
 {
  "id": "op_12f91k4",
  "texto": "A fada boa"
 },
 {
  "id": "op_1ywacg8",
  "texto": "gentil"
 },
 {
  "id": "op_3ovcp7",
  "texto": "O ogro"
 },
 {
  "id": "op_47kidb",
  "texto": "bravo"
 },
 {
  "id": "op_1u59sez",
  "texto": "A princesa"
 },
 {
  "id": "op_8f0fxm",
  "texto": "elegante"
 },
 {
  "id": "op_135clzs",
  "texto": "O bobo da corte"
 },
 {
  "id": "op_iy7fqe",
  "texto": "atrapalhado"
 },
 {
  "id": "op_1qldmbx",
  "texto": "Que jeito combina com cada um?"
 },
 {
  "id": "op_10uv9y9",
  "texto": "Fada gentil; ogro bravo; princesa elegante; bobo atrapalhado."
 },
 {
  "id": "tp_f30_intro",
  "texto": "Marque os adjetivos do cenário."
 },
 {
  "id": "tp_f30_dica",
  "texto": "Como é cada coisa da cena?"
 },
 {
  "id": "op_9mnwo5",
  "texto": "FLORESTA"
 },
 {
  "id": "op_1q3cn9r",
  "texto": "SILENCIOSA"
 },
 {
  "id": "op_pshhro",
  "texto": "ESTREITO"
 },
 {
  "id": "op_ynuu68",
  "texto": "levava a uma casa"
 },
 {
  "id": "op_1v6ympl",
  "texto": "ANTIGA"
 },
 {
  "id": "tp_f31_intro",
  "texto": "Ache os adjetivos escondidos."
 },
 {
  "id": "tp_f31_dica",
  "texto": "Como a coisa é: doce, duro, leve..."
 },
 {
  "id": "op_ykg24g",
  "texto": "DOCE"
 },
 {
  "id": "op_ykg7jz",
  "texto": "DURO"
 },
 {
  "id": "op_471c1k",
  "texto": "AZEDO"
 },
 {
  "id": "op_ykmzwy",
  "texto": "MOLE"
 },
 {
  "id": "tp_f32_intro",
  "texto": "Última leitura! Escolha a resposta certa."
 },
 {
  "id": "tp_f32_dica",
  "texto": "Releia e pense no que ele prometeu."
 },
 {
  "id": "op_g915rr",
  "texto": "Leia: «No fim, Tico agradeceu à plateia e prometeu voltar no próximo ano.» O que Tico prometeu?"
 },
 {
  "id": "op_k9trbe",
  "texto": "Voltar no próximo ano"
 },
 {
  "id": "op_19kmqjl",
  "texto": "Nunca mais atuar"
 },
 {
  "id": "op_1x6vgco",
  "texto": "Ir embora com raiva"
 },
 {
  "id": "op_11xbpjy",
  "texto": "Dormir no palco"
 },
 {
  "id": "op_1qlmrn8",
  "texto": "Procure o que ele PROMETEU."
 },
 {
  "id": "op_1mr2kfd",
  "texto": "Prometeu voltar no próximo ano."
 },
 {
  "id": "op_13ic147",
  "texto": "É «Voltar no próximo ano»."
 },
 {
  "id": "tp_f33_intro",
  "texto": "Ordene as partes da história."
 },
 {
  "id": "tp_f33_dica",
  "texto": "Leia cada parte e ache o começo."
 },
 {
  "id": "op_1qsvn6y",
  "texto": "Encontraram um baú velho."
 },
 {
  "id": "op_d3dld7",
  "texto": "Abriram devagar."
 },
 {
  "id": "op_lrfrl9",
  "texto": "Acharam um mapa dentro."
 },
 {
  "id": "op_15hfjvi",
  "texto": "Seguiram o mapa."
 },
 {
  "id": "op_1mnjowu",
  "texto": "Descobriram o tesouro."
 },
 {
  "id": "op_p84xdp",
  "texto": "A HISTÓRIA DO BAÚ"
 },
 {
  "id": "op_mz301r",
  "texto": "Ordene as partes da história."
 },
 {
  "id": "op_1tvifae",
  "texto": "Toque na parte que vem primeiro."
 },
 {
  "id": "op_12n3ow9",
  "texto": "Qual é o começo?"
 },
 {
  "id": "op_dstog6",
  "texto": "Que história bem contada!"
 },
 {
  "id": "tp_f34_intro",
  "texto": "Separe: é adjetivo ou não é?"
 },
 {
  "id": "tp_f34_dica",
  "texto": "Adjetivo diz COMO a coisa é."
 },
 {
  "id": "op_29wxk4",
  "texto": "É ADJETIVO"
 },
 {
  "id": "op_4igu6m",
  "texto": "NÃO É"
 },
 {
  "id": "op_1mzfbfl",
  "texto": "Adjetivo: alegre, rápido, bonito, forte."
 },
 {
  "id": "op_f2trb6",
  "texto": "«Cadeira» é coisa; «pular» é ação."
 },
 {
  "id": "op_1aimxea",
  "texto": "Diz COMO é, ou não?"
 },
 {
  "id": "tp_f35_intro",
  "texto": "Preencha com o pronome demonstrativo."
 },
 {
  "id": "tp_f35_dica",
  "texto": "Perto, no meio ou longe?"
 },
 {
  "id": "op_4f0kl8",
  "texto": "Me dá"
 },
 {
  "id": "op_iy3men",
  "texto": "caneta que está na tua mão."
 },
 {
  "id": "op_y7kmjn",
  "texto": "Perto de quem ouve: essa."
 },
 {
  "id": "op_ykogqx",
  "texto": "Olha"
 },
 {
  "id": "op_14taqvb",
  "texto": "quadro pendurado lá no fundo."
 },
 {
  "id": "op_dant2s",
  "texto": "Longe dos dois: aquele."
 },
 {
  "id": "op_66x6h",
  "texto": "Guarda"
 },
 {
  "id": "op_1tduixq",
  "texto": "bilhete aqui comigo."
 },
 {
  "id": "op_gqjfjx",
  "texto": "Perto de quem fala: este."
 },
 {
  "id": "tp_f36_intro",
  "texto": "Ligue cada coisa ao adjetivo."
 },
 {
  "id": "tp_f36_dica",
  "texto": "Como é cada uma?"
 },
 {
  "id": "op_bt6czx",
  "texto": "O algodão"
 },
 {
  "id": "op_1el8a9e",
  "texto": "O ferro"
 },
 {
  "id": "op_4f021e",
  "texto": "O mel"
 },
 {
  "id": "op_1epju88",
  "texto": "O limão"
 },
 {
  "id": "op_mzedfu",
  "texto": "Sinta cada coisa."
 },
 {
  "id": "op_1u1jnzy",
  "texto": "Algodão macio; ferro duro; mel doce; limão azedo."
 },
 {
  "id": "tp_f37_intro",
  "texto": "Marque os adjetivos do herói."
 },
 {
  "id": "tp_f37_dica",
  "texto": "Diga como o herói é."
 },
 {
  "id": "op_4bjhq8",
  "texto": "HERÓI"
 },
 {
  "id": "op_4dal4q",
  "texto": "JUSTO"
 },
 {
  "id": "op_952085",
  "texto": "DOURADA"
 },
 {
  "id": "op_11i3oss",
  "texto": "voava ao vento."
 },
 {
  "id": "tp_f38_intro",
  "texto": "Ache os adjetivos (todas as direções)."
 },
 {
  "id": "tp_f38_dica",
  "texto": "Palavras que descrevem o jeito."
 },
 {
  "id": "op_47x31t",
  "texto": "CALMO"
 },
 {
  "id": "op_wzd6g7",
  "texto": "ESPERTO"
 },
 {
  "id": "op_1v8u0y8",
  "texto": "Você completou todas as frases."
 },
 {
  "id": "op_l1fi9q",
  "texto": "Você colocou tudo em ordem."
 },
 {
  "id": "tp_fim",
  "texto": "Cortina! Você salvou o espetáculo do Teatro das Palavras."
 },
 {
  "id": "op_16khmm0",
  "texto": "Leia: «Tico subiu ao palco. A plateia fez silêncio. Seu coração batia forte, mas ele respirou fundo e começou a contar a história.» Como o Tico se sentiu ao subir ao palco?"
 },
 {
  "id": "op_18hkq6y",
  "texto": "Procure a parte que fala do coração dele."
 },
 {
  "id": "op_1uvzhxx",
  "texto": "É «Nervoso, mas foi corajoso». Toque nela."
 },
 {
  "id": "op_nsiwnl",
  "texto": "No trecho, quem subiu ao palco?"
 },
 {
  "id": "op_y49qot",
  "texto": "Quem é o personagem que age?"
 },
 {
  "id": "op_keh29q",
  "texto": "Foi o Tico que subiu e começou a contar."
 },
 {
  "id": "op_5iy04g",
  "texto": "É «O Tico». Toque nele."
 },
 {
  "id": "op_1sodqgg",
  "texto": "Pessoal: eu, tu, ele, ela, nós, vós, eles."
 },
 {
  "id": "op_3p6xxh",
  "texto": "«Mesa» é coisa, «correr» é ação — não são pronomes."
 },
 {
  "id": "op_yn1z09",
  "texto": "Leia: a palavra nomeia alguém (pessoa) ou não?"
 },
 {
  "id": "op_o3vm9u",
  "texto": "Ligue cada um à qualidade que combina."
 },
 {
  "id": "op_gjvw5v",
  "texto": "Qual pronome substitui «Maria»?"
 },
 {
  "id": "op_1ltuidb",
  "texto": "Quem vai brilhar? Você e o João."
 },
 {
  "id": "op_j9gz2e",
  "texto": "Tico recebeu o convite do teatro."
 },
 {
  "id": "op_sozln7",
  "texto": "Ensaiou a fala o dia inteiro."
 },
 {
  "id": "op_apora1",
  "texto": "Subiu ao palco à noite."
 },
 {
  "id": "op_1mmu2yi",
  "texto": "A primeira que falta está piscando. Toque nela."
 },
 {
  "id": "op_kueec1",
  "texto": "Estava ensolarado"
 },
 {
  "id": "op_p6l2t0",
  "texto": "Estava nevando"
 },
 {
  "id": "op_yrxq8x",
  "texto": "Fazia calor"
 },
 {
  "id": "op_vtvws9",
  "texto": "Por que ela pegou o guarda-chuva?"
 },
 {
  "id": "op_1lnqu7j",
  "texto": "É «Ia chover». Toque nela."
 },
 {
  "id": "op_1g6cbbb",
  "texto": "A palavra nomeia QUEM ou APONTA algo?"
 },
 {
  "id": "op_bzhf2j",
  "texto": "Na frase «Ela é corajosa», qual palavra é o adjetivo?"
 },
 {
  "id": "op_1vel4og",
  "texto": "É «corajosa». Toque nela."
 },
 {
  "id": "op_1mvm9eh",
  "texto": "«Aquele» aponta o palco lá longe."
 },
 {
  "id": "op_13krknv",
  "texto": "É «Aquele». Toque nela."
 },
 {
  "id": "op_fb102f",
  "texto": "Ligue à qualidade que combina."
 },
 {
  "id": "op_1mz0ucf",
  "texto": "tinha um nariz"
 },
 {
  "id": "op_1dt1wx2",
  "texto": "Leia: «A sala era pequena e escura. Havia teias nos cantos e um cheiro de mofo.» Como era a sala?"
 },
 {
  "id": "op_125bvcx",
  "texto": "Junte os detalhes: escura, teias, mofo."
 },
 {
  "id": "op_13prgi4",
  "texto": "É «Velha e abandonada». Toque nela."
 },
 {
  "id": "op_6u06ha",
  "texto": "brilhava sob a luz"
 },
 {
  "id": "op_1ix1vhb",
  "texto": "Leia: «No fim do espetáculo, Tico agradeceu à plateia e prometeu voltar no próximo ano.» O que Tico prometeu?"
 },
 {
  "id": "op_16yaef3",
  "texto": "Ele prometeu voltar no próximo ano."
 },
 {
  "id": "op_1o7ten7",
  "texto": "É «Voltar no próximo ano». Toque nela."
 },
 {
  "id": "op_1hlppf6",
  "texto": "Ficou com raiva da plateia"
 },
 {
  "id": "op_1ktmpcn",
  "texto": "«O coração batia forte» mostra o nervoso; «respirou fundo e começou» mostra a coragem."
 },
 {
  "id": "op_q1lruw",
  "texto": "É «Nervoso, mas foi corajoso». Toque nela para seguir."
 },
 {
  "id": "op_1p064u9",
  "texto": "Quem é o personagem da cena?"
 },
 {
  "id": "op_1rtnlc6",
  "texto": "Foi o Tico que subiu e começou a contar a história."
 },
 {
  "id": "op_ub644p",
  "texto": "Ele ensaiou a fala o dia inteiro."
 },
 {
  "id": "op_odsdh",
  "texto": "À noite, subiu ao palco."
 },
 {
  "id": "op_1axjt4o",
  "texto": "Contou a história para a plateia."
 },
 {
  "id": "op_ldmqyr",
  "texto": "Todos aplaudiram no final."
 },
 {
  "id": "op_14ruezk",
  "texto": "Qual foi a PRIMEIRA coisa que aconteceu?"
 },
 {
  "id": "op_1e1fdkq",
  "texto": "História na ordem certa! O espetáculo pode começar."
 },
 {
  "id": "op_5a8dt7",
  "texto": "Pessoal nomeia quem fala ou de quem se fala: eu, tu, ele, nós."
 },
 {
  "id": "op_dyj6b9",
  "texto": "Demonstrativo aponta e situa: este, esse, aquele, isto, isso."
 },
 {
  "id": "op_neyblo",
  "texto": "Leia a palavra: ela diz QUEM ou APONTA algo?"
 },
 {
  "id": "op_1xsfqsf",
  "texto": "estava muito feliz."
 },
 {
  "id": "op_tar7r1",
  "texto": "Aponta para algo perto de quem ouve: este/esse/aquele."
 },
 {
  "id": "op_kjjjvh",
  "texto": "João e eu ensaiamos."
 },
 {
  "id": "op_x1jfqi",
  "texto": "Pense: como é cada um? Essa palavra é o adjetivo."
 },
 {
  "id": "op_f6ip0w",
  "texto": "O leão é corajoso; a tartaruga é lenta; o palhaço é engraçado; a noite é escura."
 },
 {
  "id": "op_4lf40l",
  "texto": "VELHA"
 },
 {
  "id": "op_1b1zsu",
  "texto": "se abriu."
 },
 {
  "id": "op_1ymta9l",
  "texto": "Achou as 5 palavras!"
 },
 {
  "id": "op_7vohb9",
  "texto": "Cada ficha vai numa gaveta. Toque na ficha e depois na gaveta certa."
 },
 {
  "id": "op_1piywed",
  "texto": "Já achou 1 de 5! Faltam as outras."
 },
 {
  "id": "op_128v69y",
  "texto": "Já achou 2 de 5! Faltam as outras."
 },
 {
  "id": "op_eyrg5j",
  "texto": "Já achou 3 de 5! Faltam as outras."
 },
 {
  "id": "op_1qprs08",
  "texto": "Já achou 4 de 5! Faltam as outras."
 },
 {
  "id": "op_130wg52",
  "texto": "Ligue cada peça com o par dela."
 },
 {
  "id": "op_azshfr",
  "texto": "Passe o marca-texto em os ADJETIVOS do texto."
 },
 {
  "id": "op_15w9ucp",
  "texto": "Primeiro toque na ficha lá de cima. Depois toque na gaveta."
 },
 {
  "id": "op_lxear6",
  "texto": "Quem vai brilhar no palco hoje?"
 },
 {
  "id": "op_siqqjl",
  "texto": "Toque no pedaço que falta na frase."
 }
]