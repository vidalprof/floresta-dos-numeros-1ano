  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_s69mtb",
  "texto": "Escreva a palavra usando o teclado.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_14vjjbf",
  "texto": "Você chegou ao fim das três marcas do nariz! Agora você sabe quando a palavra pede o eme, quando pede o ene e quando pede o til. Leia em voz alta e escute o seu nariz.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1vw2d02",
  "texto": "JARDIM.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_rtkbu6",
  "texto": "NUVEM.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_rut8lx",
  "texto": "TAMBÉM.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_19llnvn",
  "texto": "AMENDOIM.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1d9s73k",
  "texto": "Folha pronta! Muito bem.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_z6mus",
  "texto": "O ônibus quebrou e a gente pegou o BONDE para voltar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_uelhvk",
  "texto": "A panela ficou sem a TAMPA e a sopa esfriou.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_5nibjn",
  "texto": "Cuidado para não cair no BARRANCO da estrada.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1ita2fs",
  "texto": "A AMBULÂNCIA levou o doente para o hospital.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_13eunyt",
  "texto": "O BOMBEIRO apagou o incêndio do prédio.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1o7aij7",
  "texto": "Vovó se assustou com o RELÂMPAGO e com o trovão.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1nj4tra",
  "texto": "A tampa da panela é de VIDRO e deixa ver a comida.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_17gxi51",
  "texto": "Nesta gaveta vão as palavras marcadas pela letra M.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_17gxi46",
  "texto": "Nesta gaveta vão as palavras marcadas pela letra N.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_domdv0",
  "texto": "Nesta gaveta vão as palavras marcadas pelo til, o chapeuzinho ondulado.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1wp6lbp",
  "texto": "Nesta gaveta vão as palavras em que o M vem antes da letra B.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1ycp6ke",
  "texto": "Nesta gaveta vão as palavras em que o M fecha a palavra.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1wp6kvb",
  "texto": "Nesta gaveta vão as palavras em que o M vem antes da letra P.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_n6jzu8",
  "texto": "Nesta gaveta vão as palavras com A antes da marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_kekd2s",
  "texto": "Nesta gaveta vão as palavras com E antes da marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_kxh3qw",
  "texto": "Nesta gaveta vão as palavras com I antes da marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1r3ozsu",
  "texto": "Nesta gaveta vão as palavras com O antes da marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_jyb68v",
  "texto": "Nesta gaveta vão as palavras que não são de nenhuma das duas acima.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_f7cun8",
  "texto": "Nesta gaveta vão as palavras com U antes da marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1dfdde0",
  "texto": "Letra M.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1dfddez",
  "texto": "Letra N.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1oaaion",
  "texto": "Toque numa palavra do lado esquerdo e depois na do lado direito.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_uzakgb",
  "texto": "MELANCIA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
