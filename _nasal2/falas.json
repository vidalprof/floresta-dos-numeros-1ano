  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_11zumft",
  "texto": "No fim da palavra, quase sempre quem fecha é o M.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_196lfjl",
  "texto": "Diga a palavra devagar. Qual é o pedaço que começa?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_tg6q7u",
  "texto": "Olhe a letra que vem depois da marca e lembre da regra.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_17f3qr8",
  "texto": "Leia as quatro em voz alta e procure a que não combina com as outras.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_mh40u2",
  "texto": "Leia a palavra escrita ali em cima, letra por letra, e olhe se ela tem a marca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_ynpghy",
  "texto": "Diga cada palavra com a mão no nariz. Onde ele treme, a marca está lá.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1a42bgy",
  "texto": "Escute a frase inteira outra vez e veja qual das duas faz sentido.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_6cz32q",
  "texto": "Escute a pista de novo e pense numa palavra com M antes de P ou de B.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_gazraz",
  "texto": "Procure a primeira letra da palavra e siga a linha dela.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_imocwn",
  "texto": "Olhe a letra que vem depois da lacuna desta casa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1ndi6ib",
  "texto": "Diga a palavra devagar e procure o primeiro pedaço.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_14tzh3f",
  "texto": "Escute a palavra e olhe as figuras uma por uma.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_12s9w88",
  "texto": "Diga a palavra devagar e olhe bem a marca que ela usa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_174f9xr",
  "texto": "Diga o nome de cada coisa com a mão no nariz. Onde ele treme, a marca está lá.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1crmw91",
  "texto": "Leia devagar e procure o M grudado num P ou num B.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1lm1yo2",
  "texto": "Leia a frase palavra por palavra e escute qual delas faz o nariz tremer.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_y359r3",
  "texto": "Escute a palavra de novo e comece pela primeira letra dela.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_dguqc8",
  "texto": "Leia a linha de novo e veja qual regra ela conta.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1tv4q98",
  "texto": "ONÇA, TONTO, PONTE, COMPRA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
