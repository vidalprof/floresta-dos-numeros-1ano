  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1cra80b",
  "texto": "BARRACO. BARRANCO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1snnokr",
  "texto": "BODE. BONDE.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_xozma0",
  "texto": "LOBO. LOMBO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_2aj2qz",
  "texto": "EXAME. ENXAME.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_19pk5ns",
  "texto": "CAPINA. CAMPINA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_v8ha14",
  "texto": "TAPA. TAMPA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_e4nbz8",
  "texto": "Olhe de novo LÂMPADA, CAMPO e TEMPO. Antes das letras P e B, qual delas aparece?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_fyy6nd",
  "texto": "Agora olhe DENTE, ONÇA e LARANJA. Antes das outras consoantes, qual aparece?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1d7tmgp",
  "texto": "E no fim da palavra, como em PUDIM e BOMBOM, qual delas fecha?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1ff9mjm",
  "texto": "Então, para escrever CA__PO, qual letra você põe?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_x7zyrt",
  "texto": "E para escrever CA__GURU?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_qqiw6i",
  "texto": "Primeiro toque numa palavra ali embaixo. Depois toque na gaveta dela.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1ugobv",
  "texto": "Esta casa ainda não chegou. Preencha primeiro a casa que está piscando.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1psf3qd",
  "texto": "A narração está ligada!",
  "voz": "pt-BR-AntonioNeural"
 }
]