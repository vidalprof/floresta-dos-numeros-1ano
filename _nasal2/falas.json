 },
 {
  "id": "nz_1uwobq1",
  "texto": "As Três Marcas do Nariz. Trinta e cinco folhas sobre o som que sai pelo nariz. Escreva o seu nome ali embaixo e toque em Começar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_1c1bds",
  "texto": "No fim da palavra, quem fecha é o M. Por exemplo: PUDIM, BOMBOM.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_s2guyj",
  "texto": "Antes das outras, vai sempre a letra N. Por exemplo: DENTE, ONÇA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_ld2xkt",
  "texto": "Antes de P e de B, vai sempre a letra M. Por exemplo: CAMPO, BOMBA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "nz_8hmpt7",
  "texto": "O til (~), marca o som sem letra nenhuma. Por exemplo: MAÇÃ, IRMÃ.",
