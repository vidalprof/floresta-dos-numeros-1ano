 },
 {
  "id": "op_4oudm4",
  "texto": "Leve cada peça ao lugar dela na casinha."
 },
 {
  "id": "op_nybbag",
  "texto": "Você pôs as 4 partes no lugar certo."
 },
 {
  "id": "op_u0ea9s",
  "texto": "Toque no pedaço que completa a frase."
 },
 {
  "id": "op_1v8u0y8",
  "texto": "Você completou todas as frases."
 },
 {
  "id": "op_1ih8zjc",
  "texto": "Você montou letra por letra."
 },
 {
  "id": "op_uq84tm",
  "texto": "«Bicho que mia e gosta de dormir no sol.»Monte a palavra, letra por letra."
 },
 {
  "id": "op_7vkbbr",
  "texto": "«Ele nada e vive dentro da água.»Monte a palavra, letra por letra."
 },
 {
  "id": "op_1n9rgyj",
  "texto": "«Lugar onde a gente estuda e encontra os amigos.»Monte a palavra, letra por letra."
 },
 {
  "id": "op_1tsw4fn",
  "texto": "Leve o amigo até a estrela. Desvie dos espinhudos!"
 },
 {
  "id": "op_1ohq3fw",
  "texto": "Ligue cada parte da planta com o trabalho que ela faz."
 },
 {
  "id": "op_1g1z74o",
  "texto": "Ache a palavra e o que ela quer dizer."
 },
 {
  "id": "op_l1fi9q",
  "texto": "Você colocou tudo em ordem."
 },
 {
  "id": "op_t90h3f",
  "texto": "Estes desenhos são seus. Ninguém pintou igual."
 },
 {
  "id": "op_1pyu0av",
  "texto": "Pinte «o peixe» do jeito que você quiser."
 },
 {
  "id": "op_1pf7zqp",
  "texto": "Pinte «a flor» do jeito que você quiser."
 },
 {
  "id": "op_17846g4",
  "texto": "Que horas este relógio está marcando?"
 },
 {
  "id": "op_1dcbejv",
  "texto": "Mova os ponteiros e deixe o relógio em «3 horas»."
 },
 {
  "id": "op_smplle",
  "texto": "Mova os ponteiros e deixe o relógio em «6 e meia»."
 },
 {
  "id": "op_22rc39",
  "texto": "Mova os ponteiros e deixe o relógio em «9 e quinze»."
 },
 {
  "id": "op_jd4r4w",
  "texto": "Toque na figura e depois na sombra dela."
 },
 {
  "id": "op_1hhvg7e",
  "texto": "A sombra tem a mesma forma da figura."
 },
 {
  "id": "pv_fim",
  "texto": "«o que o mascote diz na medalha, com um gancho de curiosidade»"
 }
