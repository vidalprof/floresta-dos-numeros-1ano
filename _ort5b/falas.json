  "id": "ls_1c18t3c",
  "texto": "Isso! Descanso. Som do S, entre uma vogal e uma consoante, colocamos apenas um S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1ra301b",
  "texto": "Isso! Passagem. Som de S, entre vogais, colocamos SS.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_jjsdw1",
  "texto": "Isso! Salada. Início da palavra, usamos sempre o S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1wfk71h",
  "texto": "Isso! Acima, com C.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1me5on6",
  "texto": "Isso! Crescer, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1m4p5j",
  "texto": "Isso! Descer, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_pyojix",
  "texto": "Isso! Nascer, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_phtbq6",
  "texto": "Isso! Piscina, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_13gg0z6",
  "texto": "Isso! Tecido, com C.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_fo5rax",
  "texto": "Isso! Azul, com Z.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_wm3lwf",
  "texto": "Isso! Casamento, com S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_x6p0q5",
  "texto": "Isso! Exame, com X.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_tklw8v",
  "texto": "Isso! Exemplo, com X.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1387gfx",
  "texto": "Isso! Limpeza, com Z.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_bpiipl",
  "texto": "Isso! Natureza, com Z.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_z8pf8s",
  "texto": "Isso! Raposa, com S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1brh3fm",
  "texto": "Isso! Visita, com S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1g78rwe",
  "texto": "Olhe palavra por palavra e pergunte: esse som está entre duas vogais? Então são dois SS. Está no começo, ou depois de consoante? Então é um S só.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_7ygoia",
  "texto": "Som de S entre duas vogais: são dois SS.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_17fooo3",
  "texto": "Depois do buraco vem o A, e a cedilha anda com A, O e U.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_h22ypq",
  "texto": "Não existe nenhuma palavra que começa com cedilha.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_7kdbot",
  "texto": "Depois do buraco vem o O, e a cedilha anda com A, O e U.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1ky1fsf",
  "texto": "Depois do buraco vem o I, e com E e I usamos o C.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_18d3z8p",
  "texto": "No início da palavra usamos sempre o S sozinho.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1inyd2b",
  "texto": "Ouça a palavra de novo e escute a regra de cada gaveta antes de escolher.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_15jgad7",
  "texto": "Escute a dica de novo e vá devagar: qual pedaço começa a palavra? Diga ela em voz alta, bem separadinha.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_13aemso",
  "texto": "Diga a palavra batendo uma palma em cada pedaço. Cada palma é uma sílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_2gn70n",
  "texto": "Olhe a PRIMEIRA letra de cada palavra e siga a ordem do alfabeto. Se as primeiras forem iguais, olhe a segunda.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_5d2ict",
  "texto": "Esse som vem depois de uma consoante, o N: é um S só.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1a4dckh",
  "texto": "Depois do buraco vem o Ã, e a cedilha anda com A, O e U.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_wjhcwz",
  "texto": "Depois do buraco vem o E, e com E e I usamos o C.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_asazqp",
  "texto": "Esse som vem depois de uma consoante, o R: é um S só.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1how9tg",
  "texto": "Nenhuma palavra começa com dois SS.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1mvok6t",
  "texto": "Leia a frase em voz alta e escute onde uma palavra acaba e a outra começa. Toque bem no vão entre as duas letras.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1d6h5n6",
  "texto": "Ouça de novo com calma e procure no quadro a palavra que começa com esse som.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1twjf7r",
  "texto": "Escute a pista de novo e conte as casinhas da cruzadinha: a palavra tem esse tanto de letras.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_xxq4qp",
  "texto": "Aqui o S está entre vogais e soa como Z: é um S só.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_atysxb",
  "texto": "Esse som vem depois de uma consoante, o L: é um S só.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1f68tvp",
  "texto": "Olhe a palavra letra por letra e pergunte: qual dessas regras fala justamente do pedaço difícil dela?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_ijxcox",
  "texto": "É o contrário de abaixo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_fnhyoa",
  "texto": "É o legume que faz chorar quem descasca.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_72cxfa",
  "texto": "É onde a gente assiste a filme na tela grande.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1bj9w5k",
  "texto": "É ficar maior. É da família de CRESCIMENTO, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_irtsci",
  "texto": "É o contrário de subir. É da família de DESCIDA, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_aul3ze",
  "texto": "É vir ao mundo. É da família de NASCIMENTO, com SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1ex0uz3",
  "texto": "É o tanque grande de nadar. Esta tem o dígrafo SC.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1hwx9pq",
  "texto": "É o pano de que se faz a roupa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1jzwkv2",
  "texto": "É a cor do céu limpo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_yh74k9",
  "texto": "É da família de CASA e de CASAR: fica com o S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_oozm26",
  "texto": "Começa com EX, e o X aqui soa como Z.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1nmi4q3",
  "texto": "Termina em -EZA, como BELEZA e RIQUEZA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_1mw2m42",
  "texto": "É o bicho esperto de rabo grande. Fica com o S.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "ls_12itdt2",
  "texto": "É da família de VISITAR e de VISITANTE: fica com o S.",
  "voz": "pt-BR-AntonioNeural"
