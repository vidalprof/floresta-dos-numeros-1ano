 },
 {
  "id": "mq_xfykho",
  "texto": "A Máquina de Trocar Sílabas. Trinta e cinco folhas para tirar, trocar e virar pedaços de palavra. Escreva o seu nome ali embaixo e toque em Começar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1v1krzp",
  "texto": "ACRESCENTAR é pôr um pedaço a mais. Por exemplo: CASA vira CASACO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1pybrwl",
  "texto": "INVERTER é pôr os pedaços na ordem trocada. Por exemplo: CAMA vira MACA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1lpr2l1",
  "texto": "REMOVER é tirar um pedaço e sobrar outra palavra. Por exemplo: GRATO vira GATO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_h44w5l",
  "texto": "SUBSTITUIR é trocar um pedaço por outro. Por exemplo: BOLA vira MOLA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_18xdus6",
  "texto": "Muito bem! SINO é feita desses pedaços: SI, NO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1ogcnkm",
  "texto": "Muito bem! FOGO é feita desses pedaços: FO, GO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_8tcws6",
  "texto": "Muito bem! BOLA é feita desses pedaços: BO, LA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_wtoi7q",
  "texto": "Muito bem! PATO é feita desses pedaços: PA, TO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_aiksfq",
  "texto": "Muito bem! LATA é feita desses pedaços: LA, TA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1itz7w6",
  "texto": "Muito bem! MESA é feita desses pedaços: ME, SA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_979uwq",
  "texto": "Muito bem! SORVETE é feita desses pedaços: SOR, VE, TE.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1n4clwa",
  "texto": "Muito bem! BANANA é feita desses pedaços: BA, NA, NA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1911nx6",
  "texto": "Muito bem! CACHORRO é feita desses pedaços: CA, CHOR, RO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_pnlvcq",
  "texto": "Muito bem! GATINHO é feita desses pedaços: GA, TI, NHO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_r9wbau",
  "texto": "Muito bem! PASSARINHO é feita desses pedaços: PAS, SA, RI, NHO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_wlmsom",
  "texto": "Muito bem! BORBOLETA é feita desses pedaços: BOR, BO, LE, TA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_r28pkm",
  "texto": "Muito bem! BICICLETA é feita desses pedaços: BI, CI, CLE, TA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_1jcg3sq",
  "texto": "Muito bem! PORTEIRA é feita desses pedaços: POR, TEI, RA.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "mq_15w1ovi",
  "texto": "Olhe só: sem aquela letra, GRATO virou GATO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
