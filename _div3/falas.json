  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_bhnba3",
  "texto": "Guarde onde cada carta estava: elas voltam para baixo no mesmo lugar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1eokikw",
  "texto": "Tabuleiro limpo! Você lembrou de todas.",
  "voz": "pt-BR-AntonioNeural"
 },
