 },
 {
  "id": "dd3_19jb7kv",
  "texto": "Dois gatos vão dividir 10 potes de ração. Quantos potes para cada gato?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1l6bfeb",
  "texto": "Num abrigo há 14 gatos e 7 casinhas. Quantos gatos em cada casinha?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_lqk6ga",
  "texto": "A merendeira separou 48 bolinhos e colocou 2 em cada caixa. Quantas caixas ela usou?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1qr8oy",
  "texto": "Tenho 12 balas e ponho 4 em cada saquinho. Quantos saquinhos dão?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1bh8omq",
  "texto": "São 18 cubinhos, e em cada caixa cabem 6. Quantas caixas preciso?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1uadchg",
  "texto": "Tenho 20 cenouras e ponho 5 em cada sacola. Quantas sacolas eu encho?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_7gyxv1",
  "texto": "São 30 flores, e em cada vaso cabem 10. Quantos vasos vou encher?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1j0ba0v",
  "texto": "Tenho 27 peixes e ponho 9 em cada aquário. Quantos aquários preciso?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1g2vgo3",
  "texto": "São 16 balas em saquinhos de 8. Quantos saquinhos?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_lywhi7",
  "texto": "Uma caixa leva 3 cubinhos. Quantas caixas para 21 cubinhos?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_by2zvd",
  "texto": "Antes de pintar, pegue uma canetinha ali em cima.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_icrflg",
  "texto": "Qual é a terça parte de 9?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_11g8oa6",
  "texto": "Qual é a terça parte de 12?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_pcpwo9",
  "texto": "Qual é a quarta parte de 12?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_pcq0rs",
  "texto": "Qual é a quarta parte de 20?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_w6pssf",
  "texto": "Qual é a quinta parte de 10?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_w6pwyh",
  "texto": "Qual é a quinta parte de 25?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1mg7gzk",
  "texto": "Qual é a décima parte de 30?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1mg7bye",
  "texto": "Qual é a décima parte de 50?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_z6vv8n",
  "texto": "Qual é a metade de 10?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1vsiybi",
  "texto": "Qual é a metade de 8?",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_z6vvc3",
