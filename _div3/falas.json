[
 {
  "id": "dd3_hc0c8p",
  "texto": "Aprendendo a divisão: repartir em partes iguais, medir e o resto. Trinta e cinco folhas para repartir com a mão, medir em grupos e descobrir o que sobra. Escreva o seu nome ali embaixo e toque em Começar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_s64y6s",
