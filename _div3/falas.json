  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_193tsen",
  "texto": "4 vezes 9 é 36, então 36 dividido por 9.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1f5cca0",
  "texto": "3 vezes 7 é 21, então 21 dividido por 7.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_zwsj4q",
  "texto": "10 vezes 4 é 40, então 40 dividido por 4.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1wmx2a1",
  "texto": "2 vezes 10 é 20, então 20 dividido por 10.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1ia98t0",
  "texto": "Canetinha do resultado que deu dois.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_1iliq4a",
  "texto": "Canetinha do resultado que deu três.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_d5bukp",
  "texto": "Canetinha do resultado que deu quatro.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "dd3_a06xxp",
